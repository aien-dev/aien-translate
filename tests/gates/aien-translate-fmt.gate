gate: AIEN_TRANSLATE-FMT
manifest_version: 2
owner: aien-translate
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - crates/
  - tests/
  - tests/gates/
  - src/
  - scripts/
  - demo/
run:
  exec: tests/gates/run.sh
  args: ["fmt"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
